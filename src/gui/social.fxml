<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Ana Kapsayıcı: HBox ile yan yana iki modern panel -->
<HBox spacing="25" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.SocialController" style="-fx-background-color: transparent; -fx-padding: 20;">

    <!-- Sol Panel: Arkadaş Listesi -->
    <VBox spacing="15" prefWidth="320" style="-fx-background-color: #2a2a4a; -fx-padding: 20; -fx-background-radius: 12;">
        <Label text="Arkadaşlar" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: white;"/>

        <ListView fx:id="friendsListView" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-control-inner-background: #12122a; -fx-background-radius: 8; -fx-border-color: #3a3a6a; -fx-border-radius: 8;"/>

        <!-- Arkadaş Ekle Butonu (Menüdeki mor tonlarına uygun) -->
        <Button text="+ Arkadaş Ekle" maxWidth="Infinity" onAction="#handleAddFriend" style="-fx-background-color: #5352ed; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>
    </VBox>

    <!-- Sağ Panel: Mesajlaşma Alanı -->
    <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: #2a2a4a; -fx-padding: 20; -fx-background-radius: 12;">
        <Label fx:id="chatHeaderLabel" text="Sohbet seçin..." style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: white;"/>

        <!-- Mesaj Geçmişi -->
        <ListView fx:id="messagesListView" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-control-inner-background: #12122a; -fx-background-radius: 8; -fx-border-color: #3a3a6a; -fx-border-radius: 8;"/>

        <!-- Mesaj Yazma Alanı -->
        <HBox spacing="15">
            <TextField fx:id="messageInput" promptText="Mesajınızı yazın..." HBox.hgrow="ALWAYS" onAction="#handleSendMessage" style="-fx-background-color: #12122a; -fx-text-fill: white; -fx-prompt-text-fill: #7a7a9a; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #3a3a6a; -fx-border-radius: 8;"/>

            <!-- Gönder Butonu (Yeşil) -->
            <Button text="Gönder" onAction="#handleSendMessage" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 25; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</HBox>