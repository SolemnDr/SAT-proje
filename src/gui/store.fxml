<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1030.0" spacing="20.0" style="-fx-background-color: #1a1a2e; -fx-padding: 30;" stylesheets="@/style/dark.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.StoreController">

    <!-- ÜST BAR: Arama ve Filtreleme -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2a2a5a; -fx-padding: 15; -fx-background-radius: 10;">
        <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Oyun Mağazası" />

        <!-- Arayı açmak için esnek boşluk -->
        <Region HBox.hgrow="ALWAYS" />

        <TextField fx:id="searchField" prefWidth="250.0" promptText="Oyun Ara..." style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15; -fx-background-radius: 20; -fx-border-color: #4a4acc; -fx-border-radius: 20;" />

        <ComboBox fx:id="categoryBox" prefWidth="180.0" promptText="Tüm Kategoriler" style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 20; -fx-border-color: #4a4acc; -fx-border-radius: 20;" />

        <Button onAction="#handleSearch" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="ARA" />
    </HBox>

    <!-- ORTA ALAN: Oyunların Listeleneceği Vitrin -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #1a1a2e;" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="gamesContainer" hgap="25.0" vgap="25.0" style="-fx-background-color: #1a1a2e; -fx-padding: 10;">
            <!-- Oyun Kartları Buraya Gelecek -->
        </FlowPane>
    </ScrollPane>

    <!-- ALT BAR: Sayfalama (Pagination) -->
    <HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: #12122a; -fx-padding: 15; -fx-background-radius: 10;">
        <Button fx:id="prevPageBtn" onAction="#prevPage" style="-fx-background-color: #4a4acc; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 5;" text="&lt; Önceki Sayfa" />

        <Label fx:id="pageLabel" style="-fx-text-fill: #a0a0c0; -fx-font-size: 16px; -fx-font-weight: bold;" text="Sayfa 1" />

        <Button fx:id="nextPageBtn" onAction="#nextPage" style="-fx-background-color: #4a4acc; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 5;" text="Sonraki Sayfa &gt;" />
    </HBox>

</VBox>