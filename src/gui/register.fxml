<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #1a1a2e;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.RegisterController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="GameStore | Yeni Kayıt" textFill="#5352ed">
        <font>
            <Font name="System Bold" size="28.0" />
        </font>
    </Label>

    <VBox spacing="10.0" maxWidth="350.0">
        <Label text="Kullanıcı Adı" textFill="WHITE" />
        <TextField fx:id="usernameField" promptText="Kullanıcı adınızı girin"
                   style="-fx-background-color: #2a2a5a; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" />

        <Label text="E-Posta" textFill="WHITE" />
        <TextField fx:id="emailField" promptText="Örn: halis@ytu.edu.tr"
                   style="-fx-background-color: #2a2a5a; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" />

        <Label text="Şifre" textFill="WHITE" />
        <PasswordField fx:id="passwordField" promptText="En az 6 karakter"
                       style="-fx-background-color: #2a2a5a; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" />

        <!-- GELİŞTİRİCİ OLMAK İÇİN KRİTİK SEÇİM KUTUSU -->
        <CheckBox fx:id="publisherCheckBox" text="Geliştirici (Yayıncı) olarak kaydolmak istiyorum" textFill="#a0a0b0" wrapText="true">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
            <font>
                <Font size="13.0" />
            </font>
        </CheckBox>
    </VBox>

    <Label fx:id="errorLabel" textFill="#ff4c4c" wrapText="true" />

    <VBox spacing="10.0" alignment="CENTER" maxWidth="350.0">
        <Button onAction="#handleRegister" prefWidth="350.0" text="Kayıt Ol"
                style="-fx-background-color: #5352ed; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;" />

        <HBox alignment="CENTER" spacing="5.0">
            <Label text="Zaten hesabınız var mı?" textFill="#a0a0b0" />
            <Hyperlink onAction="#handleLogin" text="Giriş Yap" textFill="#5352ed" style="-fx-font-weight: bold;" />
        </HBox>
    </VBox>
</VBox>