<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="650.0" prefWidth="450.0" spacing="0" style="-fx-background-color: #1a1a2e;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.RegisterController">

    <!-- Ana Form Konteynırı -->
    <VBox alignment="CENTER" maxWidth="360.0" spacing="20.0" style="-fx-padding: 30; -fx-background-color: #12122a; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 15, 0, 0, 8);">

        <Label text="GameStore | Kayıt" textFill="#5352ed">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>

        <VBox spacing="12.0">
            <VBox spacing="5">
                <Label text="KULLANICI ADI" textFill="#c0c0f0" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <TextField fx:id="usernameField" promptText="Kullanıcı adınızı seçin"
                           style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 11; -fx-border-color: #2a2a5a; -fx-border-radius: 8;" />
            </VBox>

            <VBox spacing="5">
                <Label text="E-POSTA" textFill="#c0c0f0" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <TextField fx:id="emailField" promptText="eposta@adresiniz.com"
                           style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 11; -fx-border-color: #2a2a5a; -fx-border-radius: 8;" />
            </VBox>

            <VBox spacing="5">
                <Label text="ŞİFRE" textFill="#c0c0f0" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <PasswordField fx:id="passwordField" promptText="En az 6 karakter"
                               style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 11; -fx-border-color: #2a2a5a; -fx-border-radius: 8;" />
            </VBox>

            <CheckBox fx:id="publisherCheckBox" text="Geliştirici (Yayıncı) hesabı aç" textFill="#a0a0b0" wrapText="true">
                <font>
                    <Font size="12.0" />
                </font>
                <VBox.margin>
                    <Insets top="5.0" />
                </VBox.margin>
            </CheckBox>
        </VBox>

        <Label fx:id="errorLabel" textFill="#ff4c4c" wrapText="true" style="-fx-font-size: 12px;" />

        <VBox spacing="10.0" alignment="CENTER">
            <Button onAction="#handleRegister" maxWidth="Infinity" text="KAYIT OL"
                    style="-fx-background-color: #5352ed; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;" />

            <HBox alignment="CENTER" spacing="5.0">
                <Label text="Zaten hesabınız var mı?" textFill="#a0a0b0" style="-fx-font-size: 13px;" />
                <Hyperlink onAction="#handleLogin" text="Giriş Yap" textFill="#5352ed" style="-fx-font-weight: bold; -fx-underline: false;" />
            </HBox>
        </VBox>
    </VBox>

    <Label text="© 2026 GameStore Project" textFill="#4a4a7a" style="-fx-font-size: 11px; -fx-padding: 20 0 0 0;" />
</VBox>