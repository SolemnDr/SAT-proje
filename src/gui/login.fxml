<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="450.0" spacing="0" style="-fx-background-color: #1a1a2e;" stylesheets="@/style/dark.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.LoginController">

    <!-- Ana Form Konteynırı (Genişliği burası daraltır) -->
    <VBox alignment="CENTER" maxWidth="360.0" spacing="25.0" style="-fx-padding: 40; -fx-background-color: #12122a; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 15, 0, 0, 8);">

        <!-- Logo ve Başlık -->
        <VBox alignment="CENTER" spacing="8">
            <Label style="-fx-text-fill: #5352ed; -fx-font-size: 32px; -fx-font-weight: bold;" text="GameStore" />
            <Label style="-fx-text-fill: #a0a0c0; -fx-font-size: 14px;" text="Hesabınıza giriş yapın" />
        </VBox>

        <!-- Giriş Alanları -->
        <VBox spacing="15">
            <!-- Kullanıcı Adı -->
            <VBox spacing="6">
                <Label style="-fx-text-fill: #c0c0f0; -fx-font-size: 11px; -fx-font-weight: bold;" text="KULLANICI ADI" />
                <TextField fx:id="usernameField" promptText="Kullanıcı adınız"
                           style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-border-color: #2a2a5a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" />
            </VBox>

            <!-- Şifre -->
            <VBox spacing="6">
                <Label style="-fx-text-fill: #c0c0f0; -fx-font-size: 11px; -fx-font-weight: bold;" text="ŞİFRE" />
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-border-color: #2a2a5a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;" />
            </VBox>
        </VBox>

        <!-- Hata Mesajı -->
        <Label fx:id="errorLabel" style="-fx-text-fill: #ff6060; -fx-font-size: 12px;" text="" wrapText="true" />

        <!-- Butonlar -->
        <VBox spacing="12">
            <Button maxWidth="Infinity" onAction="#handleLogin" prefHeight="45.0"
                    style="-fx-background-color: #5352ed; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Giriş Yap" />

            <HBox alignment="CENTER" spacing="5">
                <Label style="-fx-text-fill: #a0a0c0; -fx-font-size: 13px;" text="Hesabın yok mu?" />
                <Hyperlink onAction="#handleRegister" style="-fx-text-fill: #5352ed; -fx-font-weight: bold; -fx-underline: false;" text="Kayıt Ol" />
            </HBox>
        </VBox>

    </VBox>

    <!-- Alt Bilgi -->
    <Label style="-fx-text-fill: #4a4a7a; -fx-font-size: 11px; -fx-padding: 20 0 0 0;" text="© 2026 GameStore Project" />

</VBox>