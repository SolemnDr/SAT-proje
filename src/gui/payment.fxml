<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="720.0" prefWidth="1030.0" spacing="20.0" style="-fx-background-color: #1a1a2e; -fx-padding: 50;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.PaymentController">

    <VBox alignment="CENTER_LEFT" maxWidth="450.0" spacing="15.0" style="-fx-background-color: #2a2a5a; -fx-padding: 40; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 5);">

        <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="Güvenli Ödeme" />
        <Label style="-fx-text-fill: #a0a0c0; -fx-font-size: 14px;" text="Lütfen kart bilgilerinizi giriniz." />

        <VBox spacing="5.0">
            <Label style="-fx-text-fill: #c0c0f0;" text="Kart Üzerindeki İsim" />
            <TextField fx:id="cardNameField" promptText="AD SOYAD" style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10;" />
        </VBox>

        <VBox spacing="5.0">
            <Label style="-fx-text-fill: #c0c0f0;" text="Kart Numarası" />
            <HBox spacing="10.0">
                <TextField fx:id="cardNumberField" promptText="0000 0000 0000 0000" style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10;" HBox.hgrow="ALWAYS" />
                <Label fx:id="cardTypeLabel" alignment="CENTER" prefHeight="40.0" prefWidth="60.0" style="-fx-background-color: #4a4acc; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="?" />
            </HBox>
        </VBox>

        <HBox spacing="20.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #c0c0f0;" text="Son Kullanma (AA/YY)" />
                <TextField fx:id="expiryField" promptText="12/28" style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10;" />
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #c0c0f0;" text="CVV" />
                <TextField fx:id="cvvField" promptText="123" style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10;" />
            </VBox>
        </HBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #ff4c4c; -fx-font-size: 14px;" text="" wrapText="true" />

        <Button fx:id="payButton" maxWidth="Infinity" onAction="#handlePayment" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 12; -fx-cursor: hand;" text="ÖDEMEYİ TAMAMLA" />

        <Button maxWidth="Infinity" onAction="#cancelPayment" style="-fx-background-color: transparent; -fx-text-fill: #a0a0c0; -fx-font-size: 14px; -fx-cursor: hand;" text="İptal Et ve Sepete Dön" />
    </VBox>

</VBox>