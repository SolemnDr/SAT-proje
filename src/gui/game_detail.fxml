<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox spacing="30" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.GameDetailController" style="-fx-background-color: transparent; -fx-padding: 30;">

    <!-- SOL TARAF: OYUN BİLGİLERİ VE SATIN ALMA -->
    <VBox spacing="20" prefWidth="400" style="-fx-background-color: #2a2a4a; -fx-padding: 25; -fx-background-radius: 15;">

        <!-- Oyun Kapağı -->
        <ImageView fx:id="coverImageView" fitWidth="350" fitHeight="450" preserveRatio="true"/>

        <!-- Oyun Adı -->
        <Label fx:id="nameLabel" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" wrapText="true"/>

        <!-- Fiyat -->
        <Label fx:id="priceLabel" style="-fx-text-fill: #4caf50; -fx-font-size: 20px; -fx-font-weight: bold;"/>

        <!-- Özet -->
        <Label text="Oyun Özeti" style="-fx-text-fill: #a0a0b0; -fx-font-size: 14px; -fx-font-weight: bold;"/>
        <Label fx:id="summaryLabel" style="-fx-text-fill: white; -fx-font-size: 14px;" wrapText="true" VBox.vgrow="ALWAYS"/>

        <Region VBox.vgrow="ALWAYS" /> <!-- Boşluk Doldurucu -->

        <!-- Butonlar -->
        <Button fx:id="addToCartButton" text="Sepete Ekle" onAction="#handleAddToCart" maxWidth="Infinity" style="-fx-background-color: #5352ed; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button text="Mağazaya Dön" onAction="#handleBackToStore" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #a0a0b0; -fx-border-color: #a0a0b0; -fx-border-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
    </VBox>


    <!-- SAĞ TARAF: YORUMLAR VE DEĞERLENDİRME ALANI -->
    <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: #2a2a4a; -fx-padding: 25; -fx-background-radius: 15;">

        <Label text="Oyuncu Yorumları" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: white;"/>

        <!-- Yorumların Akacağı Liste -->
        <ListView fx:id="reviewsListView" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-control-inner-background: #12122a; -fx-background-radius: 8; -fx-border-color: #3a3a6a; -fx-border-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: white;"/>

        <Region minHeight="10"/> <!-- Araya ince bir boşluk -->

        <!-- Yorum Yazma Alanı (Siyah Kutu İçinde) -->
        <VBox spacing="10" style="-fx-background-color: #1a1a2e; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #5352ed; -fx-border-radius: 10;">
            <Label text="Kendi İncelemeni Yaz" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Puanın:" style="-fx-text-fill: #a0a0b0;"/>
                <ComboBox fx:id="ratingComboBox" promptText="1-5 Seç" style="-fx-background-color: #2a2a4a; -fx-text-fill: white;"/>
            </HBox>

            <HBox spacing="10">
                <TextField fx:id="reviewInput" promptText="Oyun hakkında ne düşünüyorsun?..." HBox.hgrow="ALWAYS" style="-fx-background-color: #2a2a4a; -fx-text-fill: white; -fx-prompt-text-fill: #7a7a9a; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #3a3a6a; -fx-border-radius: 8;"/>

                <Button text="Gönder" onAction="#handleSubmitReview" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

    </VBox>
</HBox>